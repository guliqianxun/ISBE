{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:isbe:question:common",
  "title": "Shared definitions for the question contracts",
  "$defs": {
    "run_id": {
      "description": "One question run. Opaque to clients.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "local_id": {
      "description": "An id unique within one run: a query, set, operation, batch or override.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "lang": {
      "enum": [
        "zh",
        "en"
      ]
    },
    "year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 2999
    },
    "identity_key": {
      "description": "A paper identity: an OpenAlex work, a lower-case DOI, or an arXiv id without its version suffix.",
      "type": "string",
      "pattern": "^(openalex:W[0-9]+|doi:10\\.[0-9]{4,9}/[^\\sA-Z]+|arxiv:([0-9]{4}\\.[0-9]{4,5}|[a-z-]+(\\.[A-Z]{2})?/[0-9]{7}))$"
    },
    "decision": {
      "enum": [
        "include",
        "exclude"
      ]
    },
    "paper": {
      "description": "One paper as the run knows it. `key` is the preferred identity (OpenAlex, then DOI, then arXiv); `keys` holds every identity that maps to it.",
      "type": "object",
      "required": [
        "key",
        "keys",
        "title"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/identity_key"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity_key"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "anyOf": [
            {
              "$ref": "#/$defs/year"
            },
            {
              "type": "null"
            }
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "OpenAlex work type, e.g. article or preprint."
        },
        "cited_by_count": {
          "type": "integer",
          "minimum": 0
        },
        "abstract": {
          "type": [
            "string",
            "null"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "in_archive": {
          "type": "boolean",
          "description": "The paper's full text is in the essaies archive."
        }
      },
      "additionalProperties": false
    },
    "llm_usage": {
      "description": "One model call or a sum of calls.",
      "type": "object",
      "required": [
        "model",
        "input_tokens",
        "output_tokens",
        "duration_ms"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
