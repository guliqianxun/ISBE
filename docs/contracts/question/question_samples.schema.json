{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:isbe:question:question_samples",
  "title": "question_samples@1: fixed questions and the papers each must find",
  "description": "A must-find paper counts as found when any of its keys matches any key of a paper in the run, so a preprint and its published version can both be listed.",
  "type": "object",
  "required": [
    "schema",
    "checked_on",
    "questions"
  ],
  "properties": {
    "schema": {
      "const": "question_samples@1"
    },
    "checked_on": {
      "type": "string",
      "format": "date",
      "description": "When every key was last looked up in the OpenAlex mirror."
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "lang",
          "breadth",
          "why",
          "must_find"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "lang": {
            "$ref": "urn:isbe:question:common#/$defs/lang"
          },
          "breadth": {
            "enum": [
              "narrow",
              "broad"
            ]
          },
          "topic": {
            "type": [
              "string",
              "null"
            ],
            "description": "The existing ISBE topic the question belongs to, if any."
          },
          "year_from": {
            "anyOf": [
              {
                "$ref": "urn:isbe:question:common#/$defs/year"
              },
              {
                "type": "null"
              }
            ]
          },
          "year_to": {
            "anyOf": [
              {
                "$ref": "urn:isbe:question:common#/$defs/year"
              },
              {
                "type": "null"
              }
            ]
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "What the question tests."
          },
          "must_find": {
            "type": "array",
            "minItems": 5,
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": [
                "title",
                "year",
                "keys"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "year": {
                  "$ref": "urn:isbe:question:common#/$defs/year"
                },
                "keys": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "urn:isbe:question:common#/$defs/identity_key"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
