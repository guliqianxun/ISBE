# LLM provider — set ISBE_LLM_PROVIDER to anthropic (default) or deepseek
ISBE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional per-tier model overrides (defaults per provider in llm/client.py)
# ISBE_LLM_MODEL_FAST=
# ISBE_LLM_MODEL_SMART=

# Postgres (host/port matter when running radar on the host against a remote DB)
POSTGRES_USER=isbe
POSTGRES_PASSWORD=changeme
POSTGRES_DB=isbe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# Phoenix (LLM trace) — 零登录，UI 在 http://localhost:6006。
# 留空则 trace 静默 no-op；要打开 trace，host 跑 worker 用 localhost，docker worker 用 phoenix:6006。
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=isbe

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=isbe
MINIO_ROOT_PASSWORD=changeme123

# Local mirror directories (host paths; container mounts override these)
# ISBE_ARTIFACT_MIRROR=artifacts
# ISBE_PAPERS_MIRROR=papers
# ISBE_MEMORY_ROOT=memory/me

# GitHub API token (optional) — empty = 60 req/hr; set = 5000 req/hr
# Create at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Semantic Scholar API key (optional) — empty = harsh shared rate limit (429s);
# set = much higher limit. Request free key at https://www.semanticscholar.org/product/api
# (S2_API_KEY is accepted as an alias.)
SEMANTIC_SCHOLAR_API_KEY=

# Per-email inline-image budget in bytes (default 800000). Lower it (e.g.
# 100000) for clip-prone recipients like Gmail; figures over budget become a
# pointer note, the artifact keeps them all.
# ISBE_EMAIL_IMAGE_BUDGET=

# metrail-web PDF-extraction service on the LAN (optional).
# e.g. METRAIL_API_URL=http://192.168.0.42:8000 — empty = full-text enrichment
# disabled (digests fall back to abstract-only). The service has no auth; only
# ever point this at a LAN address.
METRAIL_API_URL=

# morerssplz endpoint for the china-tech 知乎专栏 feeds. Empty = the in-network
# docker service name http://morerssplz:8000 (correct on the server and for a
# `docker compose` local stack — the collector runs inside the compose network).
# Only set this when you run `radar` DIRECTLY on a dev host (outside docker),
# where the service name doesn't resolve — then use the override-published port:
#   MORERSSPLZ_URL=http://localhost:1201
MORERSSPLZ_URL=

# Local arxiv source DB (optional) — external daily-harvest papers.db for cs.CV/ao-ph
# topics with `retrieval.source: local`. Defaults to I:\essaies\archive\arxiv-cs.CV\papers.db
ISBE_LOCAL_ARXIV_DB=

# --- Scholarly-API gateway (CN servers with stalled egress) ---
# Self-hosted Cloudflare Worker fronting ALL external paper sources — see
# infra/cloudflare/arxiv-mirror-worker.js (custom domain required in CN).
# With the worker deployed at https://api.yourdomain.com (SECRET optional):
# ARXIV_PDF_BASE_URL=https://api.yourdomain.com/<SECRET>/arxiv
# ARXIV_API_BASE_URL=https://api.yourdomain.com/<SECRET>/export-arxiv
# S2_BASE_URL=https://api.yourdomain.com/<SECRET>/s2
# Fallback list for PDFs (tried in order on timeout):
# ARXIV_PDF_MIRRORS=https://api.yourdomain.com/<SECRET>/arxiv,https://export.arxiv.org
# Per-attempt stall timeout (seconds; read-gap, slow-but-flowing is safe):
# ARXIV_PDF_TIMEOUT_S=45

# Single-user default
ISBE_UID=me

# RSSHub Chinese-source cookies (optional; routes work for ~7-30 days per cookie).
# How to obtain:
#   1. Log into zhihu.com / weibo.com / bilibili.com in a browser
#   2. DevTools → Application → Cookies → copy whole cookie header value as
#      `key1=val1; key2=val2; ...`
#   3. Paste below (use single quotes to avoid shell expansion)
# Leave blank to skip — Chinese KOL feeds in topic.yaml will then fail with
# 503 / NotFoundError, but the topic still works with non-Chinese sources.
ZHIHU_COOKIES=
WEIBO_COOKIES=

# SMTP email digest delivery (optional) — leave blank to disable notify (no-op).
# When ISBE_SMTP_HOST + ISBE_SMTP_FROM + ISBE_SMTP_TO are all set, digester
# will email the rendered digest after writing latest.md. notify never raises;
# any failure is logged to stderr and the digest pipeline still succeeds.
ISBE_SMTP_HOST=
ISBE_SMTP_FROM=
ISBE_SMTP_TO=
# Port: 587 (default) = STARTTLS; 465 = implicit SMTP_SSL.
ISBE_SMTP_PORT=587
# Auth (optional) — set both to log in; leave empty for relays that don't require auth.
ISBE_SMTP_USER=
ISBE_SMTP_PASS=
# Set to 1 to allow plaintext send when STARTTLS is refused by the relay
# (e.g. trusted localhost relay). Default: refuse, never expose creds in cleartext.
ISBE_SMTP_ALLOW_PLAINTEXT=
