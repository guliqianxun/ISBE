# LLM provider — set ISBE_LLM_PROVIDER to anthropic (default) or deepseek
ISBE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Postgres
POSTGRES_USER=isbe
POSTGRES_PASSWORD=changeme
POSTGRES_DB=isbe

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# Phoenix (LLM trace) — 零登录，UI 在 http://localhost:6006。
# 留空则 trace 静默 no-op；要打开 trace，host 跑 worker 用 localhost，docker worker 用 phoenix:6006。
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=isbe

# MinIO
MINIO_ROOT_USER=isbe
MINIO_ROOT_PASSWORD=changeme123

# GitHub API token (optional) — empty = 60 req/hr; set = 5000 req/hr
# Create at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# arxiv PDF download mirrors (CN servers often need this).
# Single override:    ARXIV_PDF_BASE_URL=https://your-mirror.example
# Comma list (tried in order on timeout):
# ARXIV_PDF_MIRRORS=https://arxiv.org,https://export.arxiv.org

# Single-user default
ISBE_UID=me

# RSSHub Chinese-source cookies (optional; routes work for ~7-30 days per cookie).
# How to obtain:
#   1. Log into zhihu.com / weibo.com / bilibili.com in a browser
#   2. DevTools → Application → Cookies → copy whole cookie header value as
#      `key1=val1; key2=val2; ...`
#   3. Paste below (use single quotes to avoid shell expansion)
# Leave blank to skip — Chinese KOL feeds in topic.yaml will then fail with
# 503 / NotFoundError, but the topic still works with non-Chinese sources.
ZHIHU_COOKIES=
WEIBO_COOKIES=

# SMTP email digest delivery (optional) — leave blank to disable notify (no-op).
# When ISBE_SMTP_HOST + ISBE_SMTP_FROM + ISBE_SMTP_TO are all set, digester
# will email the rendered digest after writing latest.md. notify never raises;
# any failure is logged to stderr and the digest pipeline still succeeds.
ISBE_SMTP_HOST=
ISBE_SMTP_FROM=
ISBE_SMTP_TO=
# Port: 587 (default) = STARTTLS; 465 = implicit SMTP_SSL.
ISBE_SMTP_PORT=587
# Auth (optional) — set both to log in; leave empty for relays that don't require auth.
ISBE_SMTP_USER=
ISBE_SMTP_PASS=
# Set to 1 to allow plaintext send when STARTTLS is refused by the relay
# (e.g. trusted localhost relay). Default: refuse, never expose creds in cleartext.
ISBE_SMTP_ALLOW_PLAINTEXT=
