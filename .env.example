# Optional environment configuration. Prefer the Web settings page for local use.
# ISBE does not load this file automatically. Inject variables through your shell,
# service manager, or Docker --env-file. Nonempty variables override saved settings.
# Uncomment only the values you want to override. Never commit real credentials.

# ISBE_DATA=data
# ISBE_BIND=127.0.0.1:8080

# ISBE_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# Explicit opt-in for a local OpenAI-compatible service that needs no key.
# Only localhost, loopback and private IP URLs are allowed; no Authorization is sent.
# ISBE_LLM_NO_AUTH=false
# ISBE_LLM_BASE_URL=
# ISBE_LLM_MODEL_FAST=
# ISBE_LLM_MODEL_SMART=
# ISBE_LLM_MAX_TOKENS=24000
# ISBE_LLM_TIMEOUT_S=900
# ISBE_LLM_EXTRA_BODY={}

# Full text: llm (arXiv HTML + existing Fast model), metrail (PDF service), or off.
# Unset: use an existing, enabled metrail configuration; otherwise use llm.
# ISBE_FULLTEXT_EXTRACTOR=llm
# ESSAIES_URL=
# METRAIL_API_URL=
# GITHUB_TOKEN=
# ARXIV_API_URL=https://export.arxiv.org/api/query
# GITHUB_API_URL=https://api.github.com

# Topic web search. SearXNG must enable JSON responses; it is not configured by default.
# SEARXNG_URL=http://127.0.0.1:8888/
# Optional for fake-IP DNS networks; queries public article hostnames via Cloudflare DoH.
# ISBE_ARTICLE_DNS=system

# Manual report email. Also editable in Service settings; environment overrides saved values.
# Keep the HTTPS endpoint verified for your Zoho account/data center. No URL default.
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURITY=tls
# SMTP_USER=
# SMTP_PASSWORD=
# For ZeptoMail API instead: EMAIL_TRANSPORT=zeptomail_api
# ZEPTOMAIL_API_URL=
# ZEPTOMAIL_TOKEN=
# SMTP_FROM=
# SMTP_FROM_NAME=ISBE
# Optional; normally managed in Settings. Comma-separated email addresses.
# ISBE_EMAIL_DEFAULT_RECIPIENTS=
